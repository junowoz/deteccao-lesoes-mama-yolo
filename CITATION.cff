    given-names: "Juan José"
  - family-names: "Ramirez Pereira Botero"
    given-names: "Felipe"
year: 2026
license: MIT
repository-code: "https://github.com/junowoz/deteccao-lesoes-mama-yolo"
keywords:
  - computer vision
  - object detection
  - YOLO
  - breast ultrasound
  - deep learning
  - computer-aided diagnosis
